<Window x:Class="KurabeteNotebook.App.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="比較ビュー" Height="600" Width="1100">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Background="#111" Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <MediaElement Name="PlayerA" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      Stretch="Uniform"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
          <Button Content="📂 開く (A)" Click="OpenA_Click" Margin="2"/>
          <Button Content="▶" Click="PlayA_Click" Margin="2"/>
          <Button Content="⏸" Click="PauseA_Click" Margin="2"/>
          <TextBlock Text="ケースA" VerticalAlignment="Center" Foreground="White" Margin="8,0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" Background="#111" Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <MediaElement Name="PlayerB" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      Stretch="Uniform"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
          <Button Content="📂 開く (B)" Click="OpenB_Click" Margin="2"/>
          <Button Content="▶" Click="PlayB_Click" Margin="2"/>
          <Button Content="⏸" Click="PauseB_Click" Margin="2"/>
          <TextBlock Text="ケースB" VerticalAlignment="Center" Foreground="White" Margin="8,0"/>
        </StackPanel>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="8">
      <Button Content="▶ 同時再生" Click="SyncPlay_Click" Margin="4" Padding="8,4"/>
      <Button Content="⏸ 同時停止" Click="SyncPause_Click" Margin="4" Padding="8,4"/>
    </StackPanel>
  </Grid>
</Window>
