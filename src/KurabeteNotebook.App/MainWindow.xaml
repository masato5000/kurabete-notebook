<Window x:Class="KurabeteNotebook.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="くらべて上手くなる" Height="780" Width="1280"
        KeyDown="Window_KeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="180"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*"/>
      <ColumnDefinition Width="2*"/>
    </Grid.ColumnDefinitions>

    <!-- Left: Video Player -->
    <Grid Grid.Row="0" Grid.Column="0" Background="#111">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <MediaElement Name="VideoPlayer" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                    Stretch="Uniform" MediaOpened="VideoPlayer_MediaOpened"
                    MediaEnded="VideoPlayer_MediaEnded"/>
      <Slider Name="SeekBar" Grid.Row="1" Margin="4,2" Minimum="0" Maximum="100"
              ValueChanged="SeekBar_ValueChanged" IsEnabled="False"
              PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
              PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,2">
        <Button Name="OpenBtn" Content="📂 動画を開く" Click="OpenBtn_Click" Margin="2"/>
        <Button Name="PlayPauseBtn" Content="▶ 再生" Click="PlayPauseBtn_Click" Margin="2" IsEnabled="False"/>
        <TextBlock Name="TimeLabel" Text="00:00:00" VerticalAlignment="Center" Margin="8,0" Foreground="White"/>
        <Button Content="🔀 比較ビュー" Click="CompareBtn_Click" Margin="2"/>
      </StackPanel>
    </Grid>

    <!-- Right: Case Editor + Lecture Card -->
    <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8">
        <TextBlock Text="ケースエディター" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Text="現在のビデオ:" Margin="0,4,0,0"/>
        <TextBlock Name="CurrentVideoLabel" Text="（未選択）" Foreground="Gray"/>
        <Separator Margin="0,8"/>

        <TextBlock Text="場面 (Scene):" Margin="0,4,0,0"/>
        <TextBox Name="FieldScene" Height="40" TextWrapping="Wrap" AcceptsReturn="True"
                 Margin="0,2" ToolTip="場面の説明"/>

        <TextBlock Text="判断 (Decision):" Margin="0,4,0,0"/>
        <TextBox Name="FieldDecision" Height="40" TextWrapping="Wrap" AcceptsReturn="True"
                 Margin="0,2" ToolTip="その場面での判断"/>

        <TextBlock Text="メモ (Memo):" Margin="0,4,0,0"/>
        <TextBox Name="FieldMemo" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                 Margin="0,2" ToolTip="自由メモ"/>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Name="OutcomeGoodBtn" Content="✓ 良い (G)" Click="OutcomeGood_Click"
                  Background="DarkGreen" Foreground="White" Margin="2" Padding="6,2"/>
          <Button Name="OutcomeBadBtn" Content="✗ 悪い (B)" Click="OutcomeBad_Click"
                  Background="DarkRed" Foreground="White" Margin="2" Padding="6,2"/>
          <Button Name="OutcomeNeutralBtn" Content="△ 中立 (N)" Click="OutcomeNeutral_Click"
                  Background="DarkOrange" Foreground="White" Margin="2" Padding="6,2"/>
        </StackPanel>

        <Button Name="SaveFieldsBtn" Content="💾 フィールドを保存" Click="SaveFields_Click"
                Margin="0,8,0,0" Padding="6,4"/>

        <Separator Margin="0,12"/>
        <TextBlock Text="講義カード" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <Border BorderBrush="LightGray" BorderThickness="1" Padding="8" CornerRadius="4">
          <TextBlock Name="LectureCard" TextWrapping="Wrap" Text="（ケースを選択してください）"
                     Foreground="Gray" FontFamily="Meiryo, MS Gothic, sans-serif"/>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Bottom: Case List -->
    <Grid Grid.Row="1" Grid.ColumnSpan="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#EEE" Margin="4,2">
        <TextBlock Text="ケース一覧  " VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBlock Text="[D]=ケース作成  [G]=良い  [B]=悪い  [N]=中立" VerticalAlignment="Center" Foreground="Gray"/>
      </StackPanel>
      <DataGrid Name="CaseList" Grid.Row="1" AutoGenerateColumns="False"
                SelectionChanged="CaseList_SelectionChanged" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
          <DataGridTextColumn Header="タイムスタンプ" Binding="{Binding TimestampDisplay}" Width="100"/>
          <DataGridTextColumn Header="結果" Binding="{Binding OutcomeDisplay}" Width="70"/>
          <DataGridTextColumn Header="メモ" Binding="{Binding Memo}" Width="*"/>
          <DataGridTextColumn Header="作成日時" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</Window>
